package fr.utbm.preypredator

import java.util.UUID
import java.util.List
import java.util.ArrayList
import static extension java.lang.Math.*
import org.eclipse.xtend.lib.annotations.Accessors

class GridEnvironment {
	
	val matrix : Body[][]

	@Accessors
	val width : int

	@Accessors
	val height : int

	
	new (width : int, height : int) {
		this.width = width
		this.height = height
		this.matrix = newArrayOfSize(width, height)
	}

	def getCellContent(x : int, y : int) {
		this.matrix.get(x).get(y)
	}

	def getAllBodies : List<Body> {
		var list = new ArrayList
		for (x : 0 ..< this.width) {
			for (y : 0 ..< this.height) {
				var cell = this.matrix.get(x).get(y)
				if (cell !== null) {
					list += cell
				}
			}
		}
		return list
	}

	def setCellContent(body : Body, x : int, y : int) : boolean {
		if (body !== null) {
			body.setPosition(x, y)
		}
		if ((0 ..< this.width).contains(x) && (0 ..< this.height).contains(y)) {
			this.matrix.get(x).set(y, body)
			return true
		}
		return false		
	}

	def findBody(id : UUID) : Body {
		for (x : 0 ..< this.width) {
			for (y : 0 ..< this.height) {
				var cell = this.matrix.get(x).get(y)
				if (cell !== null && cell.id == id) {
					return cell
				}
			}
		}
		return null
	}

	def computePerceptions(id : UUID) : List<Body> {
		var agentBody = id.findBody
		var perception = new ArrayList
		for (x : max(0, agentBody.x - 3) .. min(this.width - 1, agentBody.x + 3)) {
			for (y : max(0, agentBody.y - 3) .. min(this.height - 1, agentBody.y + 3)) {
				var cell = this.matrix.get(x).get(y)
				if (cell !== null && cell.id != id) {
					perception += cell
				}
			}
		}
		return perception
	}

	private static def range(value : int) : int {
		return min(1, max(-1, value))
	}

	def move(id : UUID, dx : int, dy : int) : boolean {
		var agentBody = id.findBody
		var nx = agentBody.x + dx.range;
		var ny = agentBody.y + dy.range;
		setCellContent(null, agentBody.x, agentBody.y)
		setCellContent(agentBody, nx, ny)
	}
	
}
